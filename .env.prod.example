# WatchSync AI — orchestration variables for docker-compose.prod.yml.
# Copy to `.env` (root) and fill in. Laravel's own config lives in backend/.env.
#
#   cp .env.prod.example .env

# ── Public domains (used by Caddy for automatic HTTPS) ───────────────────
APP_DOMAIN=app.watchsync.ai
API_DOMAIN=api.watchsync.ai

# The frontend bakes this in at build time; must be the public API origin + /api.
NEXT_PUBLIC_API_URL=https://api.watchsync.ai/api

# ── Database (MySQL 8) ───────────────────────────────────────────────────
# These MUST match DB_* in backend/.env (backend connects as DB_USERNAME).
DB_DATABASE=watchsync
DB_USERNAME=watchsync
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# ── Redis ────────────────────────────────────────────────────────────────
# Must match REDIS_PASSWORD in backend/.env.
REDIS_PASSWORD=change-me-strong-redis-password

# ── Image tags (optional; override for a registry-based deploy) ──────────
# BACKEND_IMAGE=registry.example.com/watchsync-backend:1.0.0
# NGINX_IMAGE=registry.example.com/watchsync-nginx:1.0.0
# FRONTEND_IMAGE=registry.example.com/watchsync-frontend:1.0.0
# AI_IMAGE=registry.example.com/watchsync-ai-service:1.0.0

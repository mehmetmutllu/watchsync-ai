APP_NAME=WatchSync
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Docker Ports (host tarafı) ──────────────────────
APP_PORT=8000
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
FORWARD_RABBITMQ_PORT=5672
FORWARD_RABBITMQ_DASHBOARD_PORT=15672

# ── Database ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=watchsync
DB_USERNAME=sail
DB_PASSWORD=password

# ── Session ──────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Queue & Cache (Redis) ────────────────────────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── RabbitMQ ─────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=watchsync

# ── Sanctum ──────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

# ── Frontend URL (CORS) ─────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Mail ─────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@watchsync.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (S3 — opsiyonel) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── eBay (Hafta 5+) ─────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_ENVIRONMENT=sandbox
# Marketplace Account Deletion webhook doğrulaması (boşsa dev/test'te bypass)
EBAY_WEBHOOK_VERIFICATION_TOKEN=
# eBay'e kayıtlı webhook endpoint URL'i (challenge hash'i bununla üretilir)
EBAY_WEBHOOK_ENDPOINT=

# ── Shopify (Hafta 6+) ──────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=

# ── Gemini / LLM (Google AI Studio) ──────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# ── Market Scanner (WatchCharts API — opsiyonel) ─────
# Varsa: WatchCharts API kullanılır (güvenilir fiyat verisi)
# Yoksa: Chrono24/Watchfinder scraping fallback çalışır
WATCHCHARTS_API_KEY=

# ── Sentry (Hata Takibi) ─────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

VITE_APP_NAME="${APP_NAME}"
